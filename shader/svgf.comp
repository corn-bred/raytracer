#version 430 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rgba32f, binding = 0) uniform image2D NextIterationOutput;
layout(r32f, binding = 1) uniform image2D VarianceOutput;

uniform sampler2D gDepth;
uniform sampler2D gNormal;
uniform sampler2D gMotion;
uniform sampler2D InputColour;
uniform sampler2D AccumulatedFirstMoment;
uniform sampler2D AccumulatedSecondMoment;
uniform sampler2D prevDepth;
uniform sampler2D prevNormal;
uniform sampler2D prevIterationVariance;

uniform sampler2D priorColourHistory;

uniform int FrameIndex;
uniform int Width;
uniform int Height;
uniform int Iterations;

const vec3 HumanLightSens = vec3(0.2126, 0.7152, 0.0722);
const ivec2 PixelCoords = ivec2(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y);
const float epsilon = 1e-8;

float Luminance(ivec2 point) {
    return dot(HumanLightSens, texelFetch(InputColour, point, 0).rgb);
}

float AverageLuminance(ivec2 point) { //ADD MOTION TO HERE
    return texelFetch(AccumulatedFirstMoment, point, 0).r;
}

float LuminanceVariance(ivec2 point) { //ADD MOTION TO HERE
    if (Iterations == 0) {
        return texelFetch(AccumulatedSecondMoment, point, 0).r - pow(texelFetch(AccumulatedFirstMoment, point, 0).r, 2.0);
    } else {
        return texelFetch(prevIterationVariance, point, 0).r;
    }
}

const float sigma_z = 1.0, sigma_n = 128.0, sigma_l = 4.0;
float Variance = 0.0;

vec2 nablaW(ivec2 point) { //describes the average change in depth
    float HorizontalChange = (texelFetch(gDepth, point + ivec2(1, 0), 0).r - texelFetch(gDepth, point + ivec2(-1, 0), 0).r) * 0.5;
    float VerticalChange = (texelFetch(gDepth, point + ivec2(0, 1), 0).r - texelFetch(gDepth, point + ivec2(0, -1), 0).r) * 0.5;
    return vec2(HorizontalChange, VerticalChange);
}

float hKernel[5] = {0.0625, 0.25, 0.375, 0.25, 0.0625};

float hKernel2D(ivec2 offset) {
    if ((abs(offset.x) > 2) || (abs(offset.y) > 2)) return 0.0;
    return hKernel[offset.x + 2] * hKernel[offset.y + 2];
}

float gaussKernel[3][3] = {{0.0625, 0.125, 0.0625}, {0.125, 0.25, 0.125}, {0.0625, 0.125, 0.0625}};
float GaussianVariance(ivec2 pixel) { //fix
    float Output = 0.0;
    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            Output += LuminanceVariance(pixel + ivec2(x, y));
        }
    }
    return Output;
}

//all w_ functions return a float 0-1, from 1 being agreeing to 0 being not agreeing at all

float w_z(ivec2 centre, ivec2 neighbouring) { //depth similarity, defined in equation 3
    float topVal = abs(texelFetch(gDepth, centre, 0).r - texelFetch(gDepth, neighbouring, 0).r);
    float bottomVal = sigma_z * abs( dot( nablaW(centre), vec2(centre - neighbouring) ) ) + epsilon;
    return exp(-(topVal / bottomVal));
}

float w_n(ivec2 centre, ivec2 neighbouring) { //normal similarity, defined in equation 4
    return pow(max( 0.0, dot( normalize(texelFetch(gNormal, centre, 0).xyz), normalize(texelFetch(gNormal, neighbouring, 0).xyz) ) ), sigma_n);
}

float w_l(ivec2 centre, ivec2 neighbouring) { //luminance similarity, defined in equation 5
    //this is incorrect, fix later
    float topVal = abs(AverageLuminance(centre) - AverageLuminance(neighbouring));
    float bottomVal = sigma_l * sqrt(GaussianVariance(centre)) + epsilon;
    return exp(-(topVal / bottomVal));
}

float FindWeight(ivec2 centre, ivec2 neighbouring) { //add them together
    return w_n(centre, neighbouring) * w_z(centre, neighbouring) * w_l(centre, neighbouring);
}

vec3 Weights(ivec2 centre, ivec2 neighbouring) {
    return vec3(w_n(centre, neighbouring), w_z(centre, neighbouring), w_l(centre, neighbouring));
}

vec2 FindPriorFramePix(ivec2 pixel) {
    vec2 MotionVec = texelFetch(gMotion, pixel, 0).xy;
    vec2 MotionVecPixCoord = vec2(float(MotionVec.x) * float(Width), -(float(MotionVec.y) * float(Height)));
    vec2 PriorPixCoord = vec2(pixel) - MotionVecPixCoord;
    return PriorPixCoord;
}

bool tap_n(ivec2 pixel, float threshold) {
    vec3 CurrNormal = texelFetch(gNormal, pixel, 0).xyz;
    vec3 PriorNormal = texelFetch(prevNormal, ivec2(FindPriorFramePix(pixel)), 0).xyz;
    return (dot(CurrNormal, PriorNormal) > threshold);
}

bool tap_d(ivec2 pixel, float threshold) {
    float CurrDepth = texelFetch(gDepth, pixel, 0).x;
    float PriorDepth = texelFetch(prevDepth, ivec2(FindPriorFramePix(pixel)), 0).x;
    return (abs(CurrDepth - PriorDepth) < threshold);
}

//i cant believe this

struct Tap {
    ivec2 Pos;
    float Weight;
    bool Passing;
};

vec3 TapTest(ivec2 centre) {
    vec2 ReprojPix = FindPriorFramePix(centre);
    vec2 fracReprojPix = fract(ReprojPix); //less computation??? maybe

    Tap taps[4] = {
        {ivec2(floor(ReprojPix.x), floor(ReprojPix.y)), (1.0 - fracReprojPix.x) * (1.0 - fracReprojPix.y), false},
        {ivec2(ceil(ReprojPix.x), floor(ReprojPix.y)), (fracReprojPix.x) * (1.0 - fracReprojPix.y), false},
        {ivec2(floor(ReprojPix.x), ceil(ReprojPix.y)), (1.0 - fracReprojPix.x) * (fracReprojPix.y), false},
        {ivec2(ceil(ReprojPix.x), ceil(ReprojPix.y)), (fracReprojPix.x) * (fracReprojPix.y), false}
    };
    int Tests = 0;

    for (int i = 0; i < 4; i++) {
        if (taps[i].Pos.x < 0 || taps[i].Pos.x >= Width || taps[i].Pos.y < 0 || taps[i].Pos.y >= Height) continue;
        if (!(tap_n(taps[i].Pos, 0.9) && tap_d(taps[i].Pos, 0.03))) {Tests++; taps[i].Passing == true;}
    }   

    if (Tests != 0) { //if at least 1 tap passes
        if (Tests != 4) { //& if at least 1 tap fails
            //renormalize weights

            float validWeight = 0.0;
            for (int i = 0; i < 4; i++) {
                if (taps[i].Passing) {
                    validWeight += taps[i].Weight;
                }
            }

            if (validWeight == 0.0) //edge case edge case do later do later

            //float divValidWeight = 1.0 / validWeight;

            for (int i = 0; i < 4; i++) {
                if (taps[i].Passing) {
                    taps[i].Weight /= validWeight;
                }
            }
        }
        
        //accumulation
        vec3 OutputColour = vec3(0.0);
        for (int i = 0; i < 4; i++) {
            OutputColour += texelFetch(priorColourHistory, taps[i].Pos, 0).rgb * taps[i].Weight;
        }
        return OutputColour;
    } else { //if all 2x2 taps fail
        //3x3 tap filter to check
        /*
        ...
        ...
        ...
        */
        Tap secondTaps[9] = {
            {ivec2(floor(ReprojPix.x), floor(ReprojPix.y)), 1.0 / (distance(vec2(floor(ReprojPix.x), floor(ReprojPix.y)), ReprojPix) + epsilon), false},
            {ivec2(ceil(ReprojPix.x), floor(ReprojPix.y)), 1.0 / (distance(vec2(ceil(ReprojPix.x), floor(ReprojPix.y)), ReprojPix) + epsilon), false},
            {ivec2(floor(ReprojPix.x), ceil(ReprojPix.y)), 1.0 / (distance(vec2(floor(ReprojPix.x), ceil(ReprojPix.y)), ReprojPix) + epsilon), false},
            {ivec2(ceil(ReprojPix.x), ceil(ReprojPix.y)), 1.0 / (distance(vec2(ceil(ReprojPix.x), ceil(ReprojPix.y)), ReprojPix) + epsilon), false},
            {ivec2(ceil(ReprojPix.x), floor(ReprojPix.y) - 1), 1.0 / (distance(vec2(ceil(ReprojPix.x), floor(ReprojPix.y) - 1), ReprojPix) + epsilon), false},
            {ivec2(floor(ReprojPix.x) - 1, ceil(ReprojPix.y)), 1.0 / (distance(vec2(floor(ReprojPix.x) - 1, ceil(ReprojPix.y)), ReprojPix) + epsilon), false},
            {ivec2(floor(ReprojPix.x) - 1, floor(ReprojPix.y) - 1), 1.0 / (distance(vec2(floor(ReprojPix.x) - 1, floor(ReprojPix.y) - 1), ReprojPix) + epsilon), false},
            {ivec2(floor(ReprojPix.x), floor(ReprojPix.y) - 1), 1.0 / (distance(vec2(floor(ReprojPix.x), floor(ReprojPix.y) - 1), ReprojPix) + epsilon), false},
            {ivec2(floor(ReprojPix.x) - 1, floor(ReprojPix.y)), 1.0 / (distance(vec2(floor(ReprojPix.x) - 1, floor(ReprojPix.y)), ReprojPix) + epsilon), false},
        };
        int secondTests = 0;
        for (int i = 0; i < 9; i++) {
            if (secondTaps[i].Pos.x < 0 || secondTaps[i].Pos.x >= Width || secondTaps[i].Pos.y < 0 || secondTaps[i].Pos.y >= Height) continue;
            if (!(tap_n(secondTaps[i].Pos, 0.9) && tap_d(secondTaps[i].Pos, 0.03))) {secondTests++; secondTaps[i].Passing == true;}            
        }

        if (secondTests != 0) { //if at least 1 tap passes
            if (secondTests != 9) { //& at least 1 tap fails 
                //renormalize weights

                float validWeight = 0.0;
                for (int i = 0; i < 4; i++) {
                    if (secondTaps[i].Passing) {
                        validWeight += secondTaps[i].Weight;
                    }
                }
                if (validWeight == 0.0) //edge case edge case do later do later

                //float divValidWeight = 1.0 / validWeight;

                for (int i = 0; i < 4; i++) {
                    if (secondTaps[i].Passing) {
                        secondTaps[i].Weight *= validWeight;
                    }
                }
            }

            //accumulation
            vec3 OutputColour = vec3(0.0);
            for (int i = 0; i < 4; i++) {
                OutputColour += texelFetch(priorColourHistory, taps[i].Pos, 0).rgb * taps[i].Weight;
            }
            return OutputColour;
        } else { //if all first taps fail and all second taps fail
            return texelFetch(InputColour, PixelCoords, 0).rgb;
        }
    }

    return vec3(0.0); //placeholder
}

void main() {
    if (Iterations < 0) { // that would be what we call for prior frame history + current frame accumulation. defined previously in the last lines in raytrace.comp and all of moments.comp
        float alpha = 0.2;
        vec3 IntegratedColour = alpha * texelFetch(InputColour, PixelCoords, 0).rgb + (1.0 - alpha) * TapTest(PixelCoords);
        //InputColour = Current Colour History
        //priorColourHistory = Prior colour accumulation texture
        imageStore(NextIterationOutput, PixelCoords, vec4(IntegratedColour, 1.0));
        //NextIterationOutput = Integrated Colour

    } else {
        // Variance calculation (this is following https://www.desmos.com/calculator/pbzhgpwjov btw (i made it hah)) (nevermind it isnt correct)
        int LuminanceValuesLength = 0;

        float LuminanceValues[49];
        for (int i = 0; i < 49; i++) {
            LuminanceValues[i] = 0.0;
        }

        ivec2 LuminanceCoords[49];
        for (int i = 0; i < 49; i++) {
            LuminanceCoords[i] = ivec2(0.0);
        }

        int LuminanceValuesCentrePixel = 0;
        int StepSize = int(pow(2, Iterations));

        for (int x = -3; x <= 3; x++) {
            for(int y = -3; y <= 3; y++) {
                ivec2 WriteCoords = PixelCoords + ivec2(x * StepSize, y * StepSize);

                if (x == 0 && y == 0) LuminanceValuesCentrePixel = LuminanceValuesLength;

                if ((WriteCoords.x >= 0 && WriteCoords.x < Width) && (WriteCoords.y >= 0 && WriteCoords.y < Height)) {
                    LuminanceValues[LuminanceValuesLength] = texelFetch(AccumulatedFirstMoment, WriteCoords, 0).r;
                    LuminanceCoords[LuminanceValuesLength] = WriteCoords;
                    LuminanceValuesLength++;
                }
            }
        }

        //Variance calculation

        if (Iterations == 0) {
            float varianceTopVal = 0.0;
            for (int i = 0; i < LuminanceValuesLength; i++) {
                varianceTopVal += FindWeight(LuminanceCoords[LuminanceValuesCentrePixel], LuminanceCoords[i]) * pow(LuminanceValues[i] - LuminanceValues[LuminanceValuesCentrePixel], 2.0);
            }

            float varianceBottomVal = 0.0;
            for (int i = 0; i < LuminanceValuesLength; i++) {
                varianceBottomVal += FindWeight(LuminanceCoords[LuminanceValuesCentrePixel], LuminanceCoords[i]);
            }

            Variance = varianceTopVal / max(varianceBottomVal, epsilon); //no divide by 0
        } else {
            float varianceTopVal = 0.0;
            for (int i = 0; i < LuminanceValuesLength; i++) {
                varianceTopVal += pow(hKernel2D((LuminanceCoords[i] - LuminanceCoords[LuminanceValuesCentrePixel]) / StepSize ), 2.0) * pow(FindWeight(LuminanceCoords[LuminanceValuesCentrePixel], LuminanceCoords[i]), 2.0) * texelFetch(prevIterationVariance, LuminanceCoords[i], 0).r;
            }

            float varianceBottomVal = 0.0;
            for (int i = 0; i < LuminanceValuesLength; i++) {
                varianceBottomVal += hKernel2D((LuminanceCoords[i] - LuminanceCoords[LuminanceValuesCentrePixel]) / StepSize ) * FindWeight(LuminanceCoords[LuminanceValuesCentrePixel], LuminanceCoords[i]);
            }
            varianceBottomVal = pow(varianceBottomVal, 2.0);

            Variance = varianceTopVal / max(varianceBottomVal, epsilon);
        }
        imageStore(VarianceOutput, PixelCoords, vec4(Variance, 0.0, 0.0, 1.0));

        vec3 Output;

        vec3 outputTopVal = vec3(0.0);
        vec3 outputBottomVal = vec3(0.0);
        for (int i = 0; i < LuminanceValuesLength; i++) {
            ivec2 offset = (LuminanceCoords[i] - LuminanceCoords[LuminanceValuesCentrePixel]) / StepSize;
            if ((abs(offset.x) <= 2) && (abs(offset.y) <= 2)) {
                vec3 weight = vec3(hKernel2D(offset) * FindWeight(LuminanceCoords[LuminanceValuesCentrePixel], LuminanceCoords[i]));
                outputTopVal += texelFetch(InputColour, LuminanceCoords[i], 0).rgb * weight;
                outputBottomVal += weight;
            }
        }

        Output = outputTopVal / max(outputBottomVal, vec3(epsilon));

        /*if (!TapTest(LuminanceCoords[LuminanceValuesCentrePixel])) {
            imageStore(NextIterationOutput, PixelCoords, vec4(vec3(0.0), 1.0));
        } else {
            imageStore(NextIterationOutput, PixelCoords, vec4(vec3(Output), 1.0));
        }*/

        imageStore(NextIterationOutput, PixelCoords, vec4(vec3(Output), 1.0));
    }
}