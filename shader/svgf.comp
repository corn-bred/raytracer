#version 430 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rgba32f, binding = 0) uniform image2D PostDenoisingOutput;

uniform sampler2D gDepth;
uniform sampler2D gNormal;
uniform sampler2D gMotion;
uniform sampler2D IntegratedColour;
uniform sampler2D prevFirstMoment;
uniform sampler2D prevSecondMoment;
uniform sampler2D prevDepth;
uniform sampler2D prevNormal;

uniform int Width;
uniform int Height;

const vec3 HumanLightSens = vec3(0.2126, 0.7152, 0.0722);
const ivec2 PixelCoords = ivec2(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y);

float FindWeight(float centreLuminance, float neighbouringLuminance) {
    return 0.0; //undefined for now, do it later
}

void main() {
    // Variance calculation (this is following https://www.desmos.com/calculator/pbzhgpwjov btw (i made it hah)) (nevermind it isnt correct)
    int LuminanceValuesLength = 0;
    float LuminanceValues[49] = {0.0};
    int LuminanceValuesCentrePixel = 0;

    for (int x = -3; x <= 3; x++) {
        for(int y = -3; y <= 3; y++) {
            ivec2 WriteCoords = PixelCoords + ivec2(x, y);

            if (x == 0 && y == 0) LuminanceValuesCentrePixel = LuminanceValuesLength;
            
            if ((WriteCoords.x >= 0 && WriteCoords.x < Width) && (WriteCoords.y >= 0 && WriteCoords.y < Height)) {
                LuminanceValues[LuminanceValuesLength] = dot(HumanLightSens, texelFetch(IntegratedColour, WriteCoords, 0).rgb);
                LuminanceValuesLength++;
            }
        }
    }

    float Variance = 0.0;
    
    float varianceTopVal = 0.0;
    for (int i = 0; i < LuminanceValuesLength; i++) {
        varianceTopVal += FindWeight(LuminanceValues[LuminanceValuesCentrePixel], LuminanceValues[i]) * pow(LuminanceValues[i] - LuminanceValues[LuminanceValuesCentrePixel], 2.0);
    }
    float varianceBottomVal = 0.0;
    for (int i = 0; i < LuminanceValuesLength; i++) {
        varianceBottomVal += FindWeight(LuminanceValues[LuminanceValuesCentrePixel], LuminanceValues[i]);
    }

    Variance = varianceTopVal / max(varianceBottomVal, 1e-8); //no divide by 0

