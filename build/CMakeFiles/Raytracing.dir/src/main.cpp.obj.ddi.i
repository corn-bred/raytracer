const int LEAF_THRESHOLD = 8;

struct Vertex {
    glm::vec3 Position;
    float padding0;
    glm::vec3 Normal;
    float padding1;
    glm::vec2 TexCoords;
    float padding2[2];
};

struct Triangle {
    Vertex v0;
    Vertex v1;
    Vertex v2;
};

struct Object {
