class TextureBuffer {
    GLuint texture;
    public:
    TextureBuffer(const char *texturepath, GLenum wrappingS = 0x8370, GLenum wrappingT = 0x8370, GLenum min = 0x2702, GLenum mag = 0x2601, bool isFlippedVert = true) {
        glad_glGenTextures(1, &texture);
        {
            glad_glBindTexture(0x0DE1, texture);
            glad_glTexParameteri(0x0DE1, 0x2802, wrappingS);
            glad_glTexParameteri(0x0DE1, 0x2803, wrappingT);
            glad_glTexParameteri(0x0DE1, 0x2801, min);
            glad_glTexParameteri(0x0DE1, 0x2800, mag);
            int width, height, nrchannels;
            stbi_set_flip_vertically_on_load(isFlippedVert);
            unsigned char *data = stbi_load(texturepath, &width, &height, &nrchannels, 0);
            if (data) {
                std::cerr << "SUCCESS: " << width << "x" << height << ", channels=" << nrchannels << std::endl;
                GLenum format;
                switch (nrchannels) {
                    case 1:
                    format = 0x1903; break;
                    case 2:
                    format = 0x8227; break;
                    case 3:
                    format = 0x1907; break;
                    case 4:
                    format = 0x1908; break;
                    default:
                    stbi_image_free(data); return;
                }
                glad_glTexImage2D(0x0DE1, 0, format, width, height, 0, format, 0x1401, data);
                glad_glGenerateMipmap(0x0DE1);
            } else {
                std::cerr << "Texture failed to load" << std::endl;
                glad_glDeleteTextures(1, &texture);
                texture = 0;
                return;
            }
            stbi_image_free(data);
        }
    }

    TextureBuffer() = default;

    ~TextureBuffer() {
        glad_glDeleteTextures(1, &texture);
    }

    TextureBuffer (TextureBuffer &&other) noexcept : texture(other.texture) {
        other.texture = 0;
    }

    TextureBuffer &operator= (TextureBuffer &&other) noexcept {
        if(this != &other) {
            if (texture != 0) glad_glDeleteTextures(1, &texture);
            texture = other.texture;
            other.texture = 0;
        }
        return *this;
    }

    TextureBuffer (TextureBuffer &other) = delete;
    TextureBuffer &operator= (TextureBuffer &other) = delete;

    void bindTexture(unsigned int ID) {
        glad_glActiveTexture(0x84C0 + ID);
        glad_glBindTexture(0x0DE1, texture);
    }
};
