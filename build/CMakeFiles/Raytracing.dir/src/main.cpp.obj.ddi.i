        std::vector<Texture> loadMaterialTextures(aiMaterial *mat, aiTextureType type, std::string typeName) {


            std::vector<Texture> textures;


            for (unsigned int i = 0; i < mat->GetTextureCount(type); i++) {


                aiString str;
                mat->GetTexture(type, i, &str);

                std::string fullPath = directory + '/' + str.C_Str();

                std::cout << "Looking up: " << fullPath << "... ";

                auto it = textureCache.find(fullPath);
                if (it != textureCache.end()) {
                    textures.push_back(it->second);
                    std::cout << "already loaded." << std::endl;
                    continue;
                }
                std::cout << "new texture." << std::endl;

                Texture texture;
                texture.ID = TextureFromFile(str.C_Str(), directory);
                texture.type = typeName;
                texture.path = fullPath;
                textures.push_back(texture);
                textures_loaded.push_back(texture);

                textureCache[fullPath] = texture;
            }

            std::cout << "Textures all loaded. Returning...\n";
            return textures;
        }

        void BuildTextureArray() {
            if (textures_loaded.empty()) return;

            glm::ivec2 MaxSize(0);

            for (auto &texIt : textureCache) {
                Texture &Tex = texIt.second;
                glm::ivec2 Size;
                stbi_info(Tex.path.c_str(), &Size.x, &Size.y, nullptr);
                MaxSize = glm::max(MaxSize, Size);
            }

            glad_glGenTextures(1, &TextureArrayID);
            glad_glBindTexture(0x8C1A, TextureArrayID);
            glad_glTexStorage3D(0x8C1A, 1, 0x8058, MaxSize.x, MaxSize.y, textures_loaded.size());

            int index = 0;
            for (auto &texIt : textureCache) {
                Texture &Tex = texIt.second;

                glm::ivec2 size;
                unsigned char *data = stbi_load(Tex.path.c_str(), &size.x, &size.y, nullptr, 4);

                if (data) {
                    glad_glTexSubImage3D(0x8C1A, 0, 0, 0, index, size.x, size.y, 1, 0x1908, 0x1401, data);


                    stbi_image_free(data);
                }

                index++;
            }


            glad_glTexParameteri(0x8C1A, 0x2801, 0x2702);
            glad_glTexParameteri(0x8C1A, 0x2800, 0x2601);

            glad_glBindTexture(0x8C1A, 0);

        }

        unsigned int TextureFromFile(const char *path, const std::string &directory) {
            std::string filename = std::string(path);
            filename = directory + '/' + filename;
            std::cout << "Loading texture: " << filename << std::endl;

            unsigned int textureID;
            glad_glGenTextures(1, &textureID);

            stbi_set_flip_vertically_on_load(true);

            int width, height, nrComponents;
            unsigned char *data = stbi_load(filename.c_str(), &width, &height, &nrComponents, 0);

            if (data) {
                GLenum format;
                if (nrComponents == 1)
                    format = 0x1903;
                else if (nrComponents == 3)
                    format = 0x1907;
                else if (nrComponents == 4)
                    format = 0x1908;

                glad_glBindTexture(0x0DE1, textureID);
                glad_glTexImage2D(0x0DE1, 0, format, width, height, 0, format, 0x1401, data);
                glad_glGenerateMipmap(0x0DE1);

                glad_glTexParameteri(0x0DE1, 0x2802, 0x2901);
                glad_glTexParameteri(0x0DE1, 0x2803, 0x2901);
                glad_glTexParameteri(0x0DE1, 0x2801, 0x2703);
                glad_glTexParameteri(0x0DE1, 0x2800, 0x2601);

                stbi_image_free(data);
            }
            else {
                std::cout << "Texture failed to load at path: " << path << std::endl;
                stbi_image_free(data);
            }

        return textureID;
    }
};
