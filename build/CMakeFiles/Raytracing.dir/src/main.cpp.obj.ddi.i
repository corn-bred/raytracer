class ShaderStorageBuffer {
    public:
    GLuint SSBO = 0;
    GLsizeiptr Size = 0;
    GLenum DrawType = 0x88E8;

    ShaderStorageBuffer(const void *data, GLsizeiptr size, GLenum drawtype) : Size(size), DrawType(drawtype) {
        glad_glGenBuffers(1, &SSBO);
        glad_glBindBuffer(0x90D2, SSBO);
        glad_glBufferData(0x90D2, Size, data, DrawType);
        glad_glBindBuffer(0x90D2, 0);
    }

    ShaderStorageBuffer(const ShaderStorageBuffer &other) = delete;
    ShaderStorageBuffer &operator=(const ShaderStorageBuffer &other) = delete;

    ~ShaderStorageBuffer() {
        if (SSBO != 0)
            glad_glDeleteBuffers(1, &SSBO);
    }

    ShaderStorageBuffer (ShaderStorageBuffer &&other) noexcept {
        SSBO = other.SSBO;
        Size = other.Size;
        DrawType = other.DrawType;
        other.SSBO = 0;
        other.Size = 0;
    }

    ShaderStorageBuffer &operator=(ShaderStorageBuffer &&other) noexcept {
        if (this != &other) {
            if (SSBO != 0) glad_glDeleteBuffers(1, &SSBO);
            SSBO = other.SSBO;
            Size = other.Size;
            DrawType = other.DrawType;
            other.SSBO = 0;
            other.Size = 0;
        }
        return *this;
    }

    void bindToShader(int index) {
        glad_glBindBufferBase(0x90D2, index, SSBO);
    }

    void bind() {
        glad_glBindBuffer(0x90D2, SSBO);
    }

    void unbind() {
        glad_glBindBuffer(0x90D2, 0);
    }

    void updateData(const void *data, GLsizeiptr size) {
        if (size > Size) {
            bind();
            glad_glBufferData(0x90D2, size, data, DrawType);
            unbind();
            Size = size;
        } else {
            bind();
            glad_glBufferSubData(0x90D2, 0, size, data);
            unbind();
        }
    }
};
